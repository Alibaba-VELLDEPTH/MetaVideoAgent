{
  "schema_version": 1,
  "manual_name": "OpenAI-compatible provider template",
  "planning_policy": {
    "profile_ids_are_the_only_selectable_runtime_models": true,
    "generated_code_must_use_runtime_evidence_adapters": true,
    "api_keys_are_environment_only": true,
    "dynamic_provider_model_discovery_is_forbidden": true
  },
