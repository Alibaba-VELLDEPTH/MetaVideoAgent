      "input_provenance": "bounded_text_context",
      "output_contract": "text_or_json",
      "api_key_env": ["METAVIDEOAGENT_API_KEY"],
      "base_url_env": ["METAVIDEOAGENT_BASE_URL"],
      "enabled_by_default": true
    },
